# Detect port scans
alert tcp any any -> $HOME_NET any (msg:"NMAP TCP Scan"; flags:S,12; threshold: type both, track by_src, count 10, seconds 10; sid:1000001; rev:1;)

# Detect DoS floods (like your hping3)
alert tcp any any -> $HOME_NET any (msg:"Potential TCP Flood DoS"; flow:to_server; threshold: type threshold, track by_src, count 1000, seconds 1; sid:1000002; rev:1;)

# Detect SSH brute force
alert tcp any any -> $HOME_NET 22 (msg:"SSH Brute Force"; flow:to_server; threshold: type threshold, track by_src, count 30, seconds 60; sid:1000003; rev:1;)